<!-- ChatWindow.xaml -->
<Window x:Class="ClientGUI.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Chat" Height="420" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis" />

                <Button Grid.Column="1"
                        Style="{DynamicResource TitleBarButtonStyle}"
                        Click="Minimize_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE921;"/>
                </Button>

                <Button Grid.Column="2"
                        Style="{DynamicResource TitleBarButtonStyle}"
                        Click="MaxRestore_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE922;"/>
                </Button>

                <Button Grid.Column="3"
                        Style="{DynamicResource TitleBarCloseButtonStyle}"
                        Click="Close_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;"/>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Users panel -->
            <Border Grid.Column="0"
                    BorderThickness="1"
                    CornerRadius="6"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    Padding="8">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Users"
                               FontSize="13"
                               Margin="0,0,0,8"/>

                    <ListBox x:Name="UsersListBox"
                             DisplayMemberPath="DisplayName"
                             SelectionChanged="UsersListBox_SelectionChanged"
                             PreviewMouseRightButtonUp="UsersListBox_PreviewMouseRightButtonUp"/>

                </DockPanel>
            </Border>

            <!-- Chat panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="HeaderText" FontSize="14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ConversationText"
                   Opacity="0.75"
                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                            <!-- Calls everyone in the Room (or the whisper target) -->
                            <Button x:Name="VoiceButton"
                    Width="32" Height="28"
                    Margin="0,0,6,0"
                    ToolTip="Voice call"
                    Click="VoiceButton_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE717;"/>
                            </Button>

                            <!-- Room-only: calls only the server -->
                            <Button x:Name="VoiceServerButton"
                    Width="32" Height="28"
                    ToolTip="Call server"
                    Click="VoiceServerButton_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>


                <!-- Past messages (scrolling automatically) -->
                <ListBox x:Name="MessagesListBox"
                         Grid.Row="1"
                         Margin="0,0,0,10"
                         VerticalContentAlignment="Stretch" />

                <!-- Input area -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Attachment indicator (kept the same; button is disabled for now) -->
                    <Border x:Name="AttachmentBanner"
                            Grid.Row="0"
                            Visibility="Collapsed"
                            CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            Padding="8"
                            Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock Text="📎" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AttachmentFileNameText"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <Button DockPanel.Dock="Right"
                                    Content="X"
                                    Width="26"
                                    Height="22"
                                    Margin="8,0,0,0"
                                    Click="RemoveAttachment_Click"/>
                        </DockPanel>
                    </Border>

                    <!-- Input row -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <!-- Disabled for now (no client-client file sharing yet) -->
                        <Button Grid.Column="0"
                                Width="34"
                                Height="28"
                                ToolTip="Attach a file"
                                x:Name="AttachButton"
                                Click="Attach_Click"
                                ToolTipService.ShowOnDisabled="True">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE723;" />
                        </Button>

                        <TextBox x:Name="MessageTextBox"
                                 Grid.Column="2"
                                 Height="28"
                                 VerticalContentAlignment="Center"
                                 Style="{StaticResource WatermarkTextBoxStyle}"
                                 Tag="Enter a message..."
                                 KeyDown="MessageTextBox_KeyDown"/>

                        <Button Grid.Column="4"
                                Height="28"
                                Content="Send"
                                Click="Send_Click"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</Window>
