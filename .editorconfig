root = true

# Global rules
[*]
indent_style = space
indent_size = 4
tab_width = 4
charset = utf-8
end_of_line = crlf
trim_trailing_whitespace = true
max_line_length = 200

# C# Rules
[*.cs]

#############
# Formatting
#############

# --- Indentation ---
indent_style = space
indent_size = 4

#############
# Brace Style (K&R)
#############
# No newline before open brace → K&R style like:
# if (x) {
#   ...
# }
csharp_new_line_before_open_brace = none

#############
# Parentheses & Spacing
#############

# No spaces between method name and parentheses in declarations
csharp_space_between_method_declaration_parenthesis = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false

# Space after control flow keywords (if, while, for, foreach)
# e.g., while () instead of while()
csharp_space_after_keywords_in_control_flow_statements = true

# No spaces inside parentheses
csharp_space_inside_parentheses = false

#############
# Operator Spacing
#############

# Spaces around equals sign and other binary operators
csharp_space_around_binary_operators = before_and_after

#############
# Other C# Options
#############

# Space after commas
csharp_space_after_comma = true

# No space before comma
csharp_space_before_comma = false

# No spaces between attribute brackets
csharp_space_between_square_brackets = false

#Use file-scoped namespaces by default, e.g. namespace X; instead of namespace X {}
csharp_style_namespace_declarations = file_scoped
